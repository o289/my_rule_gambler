{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-11-24",
  "env": {
    "stg": {
      "name": "gambler-stg",
      "workers_dev": false,
      "preview_urls": false,
      "main": "src/platform/cloudflare/dice-probe/worker.ts",
      "build": {
        "command": "npm run build:stg"
      },
      "assets": {
        "directory": "./dist-stg",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/*", "!/assets/*"]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "DICE_PROBE_ROOMS",
            "class_name": "DiceProbeRoom"
          }
        ]
      },
      "migrations": [
        {
          "tag": "probe-v1",
          "new_sqlite_classes": ["DiceProbeRoom"]
        }
      ]
    }
  }
}
